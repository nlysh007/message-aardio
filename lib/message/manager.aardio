import win;
import gdi;
import message.render;
import message.window;

namespace message;

class manager {
    ctor(parentHwnd = 0, globalConfig) {
        var hwnd = type(parentHwnd) == "number" ? parentHwnd : parentHwnd[["hwnd"]];
        if (!hwnd) hwnd = 0;
        var key = hwnd ? hwnd : "global";

        // 相同宿主复用管理器；再次传入配置时只更新显式覆盖项。
        var cached = ..message.manager._instances[key];
        if (cached) {
            if (key != "global" && !..win.isWindow(key)) {
                ..message.manager._instances[key] = null;
            } else {
                if (globalConfig) {
                    ..table.assign(cached.globalOverrides, globalConfig);
                    cached.globalConfig = ..table.assign(
                        {},
                        ..message.config.default,
                        cached.globalOverrides
                    );
                }
                return cached;
            }
        }

        this.parentHwnd = hwnd;
        this.queues = { {};{};{};{};{};{};{};{};{} };
        this.globalOverrides = ..table.assign({}, globalConfig);
        this.globalConfig = ..table.assign(
            {},
            ..message.config.default,
            this.globalOverrides
        );
        ..message.manager._instances[key] = this;
    };

    // 宿主窗口使用客户区屏幕坐标，避免消息遮住标题栏与窗口边框。
    getBaseRect = function() {
        if (this.parentHwnd && ..win.isWindow(this.parentHwnd)
            && !..win.isIconic(this.parentHwnd)) {
            var rcClient = ..win.getClientRect(this.parentHwnd);
            var x, y = ..win.toScreen(this.parentHwnd, 0, 0);
            return ::RECT(x, y, x + rcClient.width(), y + rcClient.height());
        }

        var activeHwnd = ..win.getForeground();
        if (activeHwnd) {
            var monitorInfo = ..win.getMonitorInfo(activeHwnd);
            if (monitorInfo && monitorInfo.rcWork) return monitorInfo.rcWork;
        }
        return ..win.getWorkArea();
    };

    // 清除该管理器下所有消息。先清空队列，避免逐个关闭时发生无意义的反复重排。
    clearAll = function(immediate = true) {
        var pending = [];
        for (pos = 1; 9; 1) {
            var q = this.queues[pos];
            if (q) ..table.append(pending, q);
            this.queues[pos] = {};
        }

        for (i = #pending; 1; -1) {
            var item = pending[i];
            if (item && !item.destroyed) item.close(immediate);
        }
    };

    // 更新一个九宫格位置的排列。顶部向下、底部向上；4/5/6 在中线覆盖堆叠。
    updateQueue = function(pos, rcBase) {
        var q = this.queues[pos];
        if (!q || !#q) return;
        rcBase := this.getBaseRect();

        var maxVisible = ..math.max(1, ..math.round(q[1].config.maxVisible : 6));
        var overflow = [];
        while (#q > maxVisible) {
            var oldItem = ..table.remove(q, #q);
            if (oldItem) ..table.push(overflow, oldItem);
        }

        var alignX = (pos - 1) % 3;
        var currentY;

        for (i = 1; #q; 1) {
            var msgObj = q[i];
            var targetX;
            var targetY;
            var margin = msgObj.config.margin;

            if (alignX == 0) targetX = rcBase.left + margin;
            elseif (alignX == 1) targetX = rcBase.left + (rcBase.width() - msgObj.w) / 2;
            else targetX = rcBase.right - margin - msgObj.w;

            if (pos <= 3) {
                if (i == 1) currentY = rcBase.bottom - margin;
                currentY -= msgObj.h;
                targetY = currentY;
                currentY -= msgObj.config.spacing;
            } elseif (pos >= 7) {
                if (i == 1) currentY = rcBase.top + margin;
                targetY = currentY;
                currentY += msgObj.h + msgObj.config.spacing;
            } else {
                // 中部三个位置使用覆盖堆叠：每张卡片按自身高度独立居中，最新消息位于顶层。
                targetY = rcBase.top + (rcBase.height() - msgObj.h) / 2;
            }

            // 超窄宿主窗口仍保证卡片中心尽量落在可见区域。
            if (msgObj.w <= rcBase.width()) {
                targetX = ..math.max(rcBase.left, ..math.min(targetX, rcBase.right - msgObj.w));
            } else {
                targetX = rcBase.left + (rcBase.width() - msgObj.w) / 2;
            }
            msgObj.setTargetPos(targetX, targetY);
        }

        // 已移出队列的旧消息仍保留退场动画，但不再参与布局。
        for (i = 1; #overflow; 1) overflow[i].close();
    };

    // 创建并显示消息。
    show = function(text, opt) {
        if (type(opt) == "number") opt = { pos = opt };
        var rawOpt = ..table.assign({}, opt);
        var themeName = rawOpt.themeName;
        var rcBase = this.getBaseRect();
        var dpiScale = ..gdi.getDpiScale(null, this.parentHwnd);
        if (!dpiScale || dpiScale < 0.5) dpiScale = 1;

        var cfg = ..message.manager.prepareConfig(
            this,
            rawOpt,
            themeName,
            dpiScale,
            rcBase
        );

        var layoutData = ..message.render(text, cfg).render();
        var distance = ..math.round((cfg.slideDistance : 36) * dpiScale);
        var offset = {
            x = ((cfg.pos - 1) % 3 - 1) * distance;
            y = (1 - ..math.floor((cfg.pos - 1) / 3)) * distance;
        };

        var managerObj = this;
        var q = this.queues[cfg.pos];
        var msgObj = ..message.window(layoutData, offset, this.parentHwnd);
        msgObj.rawText = tostring(text) : "";
        msgObj.rawOpt = rawOpt;
        msgObj.themeName = themeName;

        // 文本变化只重建该消息的静态位图，随后按新宽高重新排队。
        msgObj.onTextChanged = function(newText) {
            if (msgObj.destroyed || msgObj.isClosing) return;
            var newLayout = ..message.render(newText, msgObj.config).render();
            msgObj.updateLayoutData(newLayout);
            managerObj.updateQueue(msgObj.config.pos);
        };

        // 窗口开始关闭时立即退出队列，让剩余消息同步补位。
        msgObj.onClose = function() {
            var currentQueue = managerObj.queues[msgObj.config.pos];
            if (currentQueue) {
                for (i = 1; #currentQueue; 1) {
                    if (currentQueue[i] == msgObj) {
                        ..table.remove(currentQueue, i);
                        break;
                    }
                }
            }
            managerObj.updateQueue(msgObj.config.pos);
        };

        ..table.insert(q, msgObj, 1);
        this.updateQueue(cfg.pos, rcBase);
        return msgObj;
    };
}

namespace manager {
    _instances = {};

    // 将逻辑像素配置转换为当前显示器的实际像素配置。
    prepareConfig = function(instance, rawOpt, themeName, dpiScale, rcBase) {
        var mode = ..message.config.mode;
        var themes = ..message.config.themes[mode] : ..message.config.themes.light;
        var themeCfg = themeName ? themes[themeName] : themes.default;
        if (!themeCfg) themeCfg = themes.default;

        var cfg = ..table.assign(
            {},
            ..message.config.default,
            themeCfg,
            instance.globalOverrides,
            rawOpt
        );
        // 固化本次渲染使用的主题，避免图片调色依赖随后可能变化的全局状态。
        cfg.themeMode = mode;

        var posValue = tonumber(cfg.pos);
        if (posValue === null) posValue = 8;
        cfg.pos = ..math.max(1, ..math.min(9, ..math.round(posValue)));

        // duration=0 是“常驻”语义，不能使用假值兜底表达式。
        var durationValue = tonumber(cfg.duration);
        if (durationValue === null) durationValue = 3000;
        cfg.duration = ..math.max(0, ..math.round(durationValue));
        cfg.dpiScale = dpiScale;

        var heightValue = tonumber(cfg.h);
        if (heightValue === null) heightValue = 48;
        var marginValue = tonumber(cfg.margin);
        if (marginValue === null) marginValue = 18;
        var spacingValue = tonumber(cfg.spacing);
        if (spacingValue === null) spacingValue = 10;
        var fontSizeValue = tonumber(cfg.fontSize);
        if (fontSizeValue === null) fontSizeValue = 15;

        cfg.h = ..math.max(1, ..math.round(heightValue * dpiScale));
        cfg.margin = ..math.max(0, ..math.round(marginValue * dpiScale));
        cfg.spacing = ..math.max(0, ..math.round(spacingValue * dpiScale));
        cfg.fontSize = ..math.max(1, ..math.round(fontSizeValue * dpiScale));

        if (cfg.icon) {
            cfg.icon = ..table.assign({}, cfg.icon);
            var iconSizeValue = tonumber(cfg.icon.size);
            if (iconSizeValue === null) iconSizeValue = 18;
            cfg.icon.size = ..math.max(1, ..math.round(iconSizeValue * dpiScale));
        }

        // maxWidth 仍保持逻辑像素，由 render 统一缩放；这里仅按宿主可用宽度收窄。
        if (rcBase && rcBase.width() > 0) {
            var availableLogical = (rcBase.width() - cfg.margin * 2) / dpiScale;
            if (availableLogical > 80) {
                var maxWidthValue = tonumber(cfg.maxWidth);
                if (maxWidthValue === null) maxWidthValue = 600;
                cfg.maxWidth = ..math.min(maxWidthValue, availableLogical);
            }
        }
        return cfg;
    };

    clearAllGlobal = function(immediate = true) {
        for (key, instance in _instances) {
            if (instance) instance.clearAll(immediate);
        }
    };

    // 全局同步主题，完整更新位图、尺寸、命中区与队列位置。
    syncThemeAll = function() {
        for (key, instance in _instances) {
            if (!instance) continue;
            if (key != "global" && !..win.isWindow(key)) {
                instance.clearAll(true);
                _instances[key] = null;
                continue;
            }

            var rcBase = instance.getBaseRect();
            var dpiScale = ..gdi.getDpiScale(null, instance.parentHwnd);
            if (!dpiScale || dpiScale < 0.5) dpiScale = 1;

            for (pos = 1; 9; 1) {
                var q = instance.queues[pos];
                if (!q || !#q) continue;

                for (i = 1; #q; 1) {
                    var msgObj = q[i];
                    if (!msgObj || msgObj.destroyed || msgObj.isClosing) continue;

                    var newCfg = prepareConfig(
                        instance,
                        msgObj.rawOpt,
                        msgObj.themeName,
                        dpiScale,
                        rcBase
                    );
                    var newLayout = ..message.render(msgObj.rawText, newCfg).render();
                    msgObj.updateTheme(newLayout);
                }
                instance.updateQueue(pos, rcBase);
            }
        }
    };
}