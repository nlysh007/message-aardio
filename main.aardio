import win.ui;
/*DSG{{*/
mainForm = win.form(text="message";right=247;bottom=299;border="thin")
mainForm.add(
doc={cls="button";text="打开文档";left=32;top=208;right=216;bottom=256;db=1;dl=1;dr=1;dt=1;z=3};
extlib={cls="button";text="生成扩展库";left=32;top=48;right=216;bottom=96;dl=1;dr=1;dt=1;z=1};
test={cls="button";text="运行测试";left=32;top=128;right=216;bottom=176;db=1;dl=1;dr=1;dt=1;z=2}
)
/*}}*/

mainForm.extlib.oncommand = function(id,event){
	
	var extlib = mainForm.loadForm("~\tools\IDE\extlib.aardio");
		extlib.editLibName.text = "message";
		extlib.show();
}

mainForm.test.oncommand = function(id,event){
	
	var test = mainForm.loadForm("\dlg\test.aardio");
		test.show();

}

mainForm.doc.oncommand = function(id,event){

	var frmChild = mainForm.loadForm("\dlg\doc.aardio");
		frmChild.show();

		
}

mainForm.show();
return win.loopMessage();